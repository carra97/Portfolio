# Contacto — se leen en el servidor y se inyectan en el HTML renderizado.
# Si CONTACT_PHONE_E164 queda vacío, el botón de WhatsApp no se renderiza.
# Formato E.164 obligatorio si se completa: '+' + código de país + número, sin espacios.
CONTACT_EMAIL=
CONTACT_PHONE_E164=

# URL canónica del sitio (metadata, Open Graph, sitemap).
SITE_URL=

# Chatbot — kill switch. Con 'false' el sitio funciona completo, sin chat.
CHAT_ENABLED=false

# Proveedor de LLM: anthropic | gemini | openai. Solo se necesita la clave del elegido.
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Modelo de Gemini. Opcional: si queda vacío se usa gemini-3.5-flash-lite.
# Se lee por invocación, así que cambiarlo en el panel de deploy NO exige recompilar.
# Cambiarlo sí exige volver a correr `npm run evals`.
GEMINI_MODEL=

# Rate limit por IP (Upstash Redis). En PRODUCCIÓN, sin esto el chat NO se habilita:
# un endpoint de LLM sin límite de gasto es una factura abierta.
# En desarrollo se usa un contador en memoria y estas dos pueden quedar vacías.
# Los nombres son los que entrega la consola de Upstash: se copian y pegan tal cual.
# Se aceptan también KV_REST_API_URL y KV_REST_API_TOKEN como alias (viejo Vercel KV).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Notas de despliegue del chat
#
# 1. CHAT_ENABLED se evalúa en BUILD, no por request: las páginas se prerenderizan.
#    Cambiar esta variable exige un redeploy, no alcanza con tocarla en el panel.
# 2. El tope de gasto NO vive acá: se configura en la cuenta del proveedor. Es la mitad
#    del control de costos que el código no puede hacer cumplir. Sin tope configurado,
#    no deployar con el chat encendido.
#    Con LLM_PROVIDER=gemini y una cuenta SIN facturación habilitada, ese tope lo hace
#    cumplir el proveedor: agotada la cuota diaria devuelve 429 y el chat deja de
#    responder. Habilitar facturación en ese proyecto de Google elimina esa garantía.
# 3. Para desarrollar el widget sin ninguna clave real: CHAT_ENABLED=true y dejar la
#    clave vacía. La factory devuelve un proveedor simulado que streamea texto de prueba.
# ─────────────────────────────────────────────────────────────────────────────
